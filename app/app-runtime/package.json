{
  "name": "@dqa-ai-solutions/app-runtime",
  "version": "0.2.0",
  "description": "The app tier, server side: process runner, view resolver and loaders, calendar and cascade-ledger libraries. Stands on @dqa-ai-solutions/core-runtime; screens are @dqa-ai-solutions/ui-runtime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DQASolutions/app-runtime.git",
    "directory": "app/app-runtime"
  },
  "homepage": "https://github.com/DQASolutions/app-runtime#readme",
  "bugs": {
    "url": "https://github.com/DQASolutions/app-runtime/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./calendar": {
      "types": "./dist/calendar/index.d.ts",
      "import": "./dist/calendar/index.js"
    },
    "./cascade-ledger": {
      "types": "./dist/cascade-ledger/index.d.ts",
      "import": "./dist/cascade-ledger/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc -p tsconfig.check.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dqa-ai-solutions/ontology-view": "^0.29.2",
    "@dqa-ai-solutions/workflow-process": "^5.12.0"
  },
  "devDependencies": {
    "@dqa-ai-solutions/core-runtime": "^0.2.0",
    "@types/node": "^25.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@dqa-ai-solutions/core-runtime": "^0.2.0"
  }
}
