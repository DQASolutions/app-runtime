{
  "name": "app-runtime-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Source of @dqa-ai-solutions/app-runtime. The app tier in one package: process runner, view layer, calendar and cascade-ledger libraries; screens at ./ui-kit and ./ui-react. Stands on @dqa-ai-solutions/core-runtime.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "app/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.9.3",
    "@dqa-ai-solutions/core-runtime": "^0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2",
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.68.5",
    "@rolldown/binding-linux-x64-gnu": "1.2.19"
  }
}
